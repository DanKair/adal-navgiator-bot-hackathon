# PostgreSQL's built-in administrator password. The database container uses
# this account for initialization and health checks; the application does not.
# It is applied when PostgreSQL initializes a new data volume; changing it
# later does not rotate the password in an already-initialized database.
POSTGRES_PASSWORD=change-this-postgres-admin-password

# Password for the separate, limited-privilege adal_app database role.
# The API connects as adal_app with this password. Keep it different from
# POSTGRES_PASSWORD: this is the app's credential, not the database admin one.
# The role is created during initial database setup, so changing this later
# also requires updating the existing role's password in PostgreSQL.
APP_DB_PASSWORD=change-this-app-password

# Connection string for running the app directly on your computer.
# Docker Compose overrides it for the app container with host "db" and
# APP_DB_PASSWORD. Do not use POSTGRES_PASSWORD in the application URL.
DATABASE_URL=postgresql+asyncpg://adal_app:change-this-app-password@db:5432/adal

# Secret used to HMAC-hash browser session IDs before they are stored.
# Use a random value of at least 32 bytes; keep it private and stable between runs.
CHAT_ID_HMAC_SECRET=replace-with-a-random-secret-at-least-32-bytes

# Runtime mode and verbosity of server logs.
APP_ENV=production
LOG_LEVEL=INFO

# LLM providers to try in order. Providers without credentials/model settings are skipped.
LLM_PROVIDER_ORDER=gemini,openrouter,ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODELS=inception/mercury-decide:free
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Local Ollama embeddings: use the same model for indexing and querying so their
# vectors are comparable.
EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_URL=http://localhost:11434/api/embed

# Per-request timeouts, in seconds, for cloud and local LLM calls.
LLM_TIMEOUT_CLOUD_S=15
LLM_TIMEOUT_LOCAL_S=60

# Circuit breaker: after this many consecutive provider failures, skip it for
# the configured cooldown (seconds), then allow it to be tried again.
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN_S=60

# Retrieval: number of nearest source chunks to consider, and minimum similarity
# score for keeping a result. Tune the score against real Russian/Kazakh queries.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.45

# Maximum user-message length accepted by the API, in characters.
MAX_MESSAGE_LENGTH=4000
